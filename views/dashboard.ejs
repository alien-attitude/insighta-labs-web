<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="container">
  <div class="page-header">
    <h2>Dashboard</h2>
    <p>Welcome back, <strong>@<%= user?.username || 'user' %></strong>
      <span class="badge badge-<%= user?.role %>"><%= user?.role %></span>
    </p>
  </div>

  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon">👥</div>
      <div class="stat-value"><%= total.toLocaleString() %></div>
      <div class="stat-label">Total Profiles</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">♂</div>
      <div class="stat-value"><%= males.toLocaleString() %></div>
      <div class="stat-label">Male Profiles</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">♀</div>
      <div class="stat-value"><%= females.toLocaleString() %></div>
      <div class="stat-label">Female Profiles</div>
    </div>
    <div class="stat-card">
      <div class="stat-icon">🌍</div>
      <div class="stat-value">65</div>
      <div class="stat-label">Countries</div>
    </div>
  </div>

  <div class="quick-actions">
    <h3>Quick Actions</h3>
    <div class="action-grid">
      <a href="/profiles" class="action-card">
        <span>📋</span>
        <strong>Browse Profiles</strong>
        <p>Filter, sort, and paginate</p>
      </a>
      <a href="/search" class="action-card">
        <span>🔍</span>
        <strong>Natural Language Search</strong>
        <p>"young males from nigeria"</p>
      </a>
      <% if (user?.role === 'admin') { %>
      <a href="/profiles?export=csv" class="action-card">
        <span>📥</span>
        <strong>Export CSV</strong>
        <p>Download all profiles</p>
      </a>
      <% } %>
      <a href="/account" class="action-card">
        <span>👤</span>
        <strong>My Account</strong>
        <p>View your profile & role</p>
      </a>
    </div>
  </div>
</main>

<%- include('partials/foot') %>
